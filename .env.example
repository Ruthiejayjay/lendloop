# Convex (auto-populated by `npx convex dev`)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Clerk (from Clerk Dashboard -> API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Shared HMAC secret for signing/verifying Convex <-> n8n payloads
# Generate with: openssl rand -hex 32
N8N_HMAC_SECRET=

# Optional: public tunnel URL when testing Convex Cloud -> local n8n webhooks
N8N_WEBHOOK_BASE_URL=http://localhost:5678/